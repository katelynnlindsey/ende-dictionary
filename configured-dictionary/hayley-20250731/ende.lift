<form lang="kit"><text>Ttongo ause bo bin a Madima, Kinkin ttängäm me giddollag daeya. </text></form>
<translation type="Free translation">
<form lang="en"><text>An old woman, her name is Madima, was living in Kinkin village.</text></form>
</translation>
<note type="reference">
<form lang="kit"><text><span href="silfw://localhost/link?tool%3dinterlinearEdit%26guid%3d50544f76-8e47-4ad8-a042-95b8e484723e%26tag%3d" class="Hyperlink">WE_SN006 1.1</span></text></form>
