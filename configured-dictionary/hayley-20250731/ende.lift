<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>coconut_growth_stage</text></gloss>
<definition>
<form lang="en"><text>the ninth stage of coconut growth in which the endosperm of the fruit is fully formed and coconut water remains</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example source="Tonny Warama">
