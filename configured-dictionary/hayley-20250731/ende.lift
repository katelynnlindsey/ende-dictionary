<form lang="en"><text>Upiara villagers call me Kaya.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Kumddäga pemli de ngäna amim nättaemnegan, ngämi ubim mɨnyi umllang bägaebeya.</text></form>
<translation type="Free translation">
<form lang="en"><text>The three families I named, we (excl.) will tell them.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
