</grammatical-info>
<gloss lang="en"><text>plant_body</text></gloss>
<definition>
<form lang="en"><text>trunk of a plant in the ground; a single plant</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
