<entry dateCreated="2017-07-08T20:05:53Z" dateModified="2025-05-18T01:50:31Z" id="ik_4618af22-c309-47d0-a340-c52b8ba9154b" guid="4618af22-c309-47d0-a340-c52b8ba9154b">
<lexical-unit>
<form lang="kit"><text>ik</text></form>
<form lang="kit-fonipa"><text>ik</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<pronunciation>
<form lang="kit-fonipa"><text>ik</text></form>
</pronunciation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<sense id="b34f6c84-026b-4eef-acc2-6f966efad93c">
<grammatical-info value="Locational">
</grammatical-info>
<gloss lang="en"><text>inside</text></gloss>
<definition>
<form lang="en"><text>inside</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example source="SE-TN016 22.1">
<form lang="kit"><text>Bogo dindugän do kukiny mama de ikop dägagän dibaeya däbe ik e gotärakän do gotägolän.</text></form>
<translation type="Free translation">
<form lang="en"><text>He ran to a pile of tall grass that he saw, went inside, and hid there.</text></form>
</translation>
<note type="reference">
<form lang="kit"><text><span href="silfw://localhost/link?tool%3dinterlinearEdit%26guid%3d530da1eb-e55d-4b77-9f4d-eb3895ff4165%26tag%3d" class="Hyperlink">SE-TN016 22.1</span></text></form>
</note>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example source="SE-TN019 32.1">
<form lang="kit"><text>Lama wa Mana ubi kandärmang me goensegäneyo adawatta Emi aoli kuddäll de ine ik me ikop dägagän.</text></form>
<translation type="Free translation">
<form lang="en"><text>Lama and Mana were both feeling sorry because they saw that Emi almost died in the water.</text></form>
</translation>
<note type="reference">
<form lang="kit"><text><span href="silfw://localhost/link?tool%3dinterlinearEdit%26guid%3d07613564-d37a-427c-86e8-960268c544a5%26tag%3d" class="Hyperlink">SE-TN019 32.1</span></text></form>
</note>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Bogo poper gogon, ma ik atta gogezänän wälläng e dindugän.</text></form>
<translation type="Free translation">
<form lang="en"><text>He was shocked, got out from inside, and ran into the bush.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<trait name ="semantic-domain-ddp4" value="8.5.1.4 Inside"/>
<reversal type="en"><form lang="en"><text>in</text></form>
</reversal>
<reversal type="en"><form lang="en"><text>inside</text></form>
</reversal>
<illustration href="">
</illustration><relation type="Synonyms" ref="2318f046-6494-4f6f-bec4-d00af67e0d02"/>
<relation type="Antonym" ref="80cd18fd-e6bd-41ea-9897-c5b2a8b4fe07"/>
</sense>
</entry>
