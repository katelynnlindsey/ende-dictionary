</lexical-unit>
<trait  name="morph-type" value="phrase"/>
<etymology type="borrowed" source="">
<field type="preccomment">
<form lang="en"><text>taempäg + =ang, lit. 'way-shower'</text></form>
</field>
</etymology>
<pronunciation>
</pronunciation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<sense id="2138386a-b0ae-499f-aa8e-8fcdccc55053">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>navigator</text></gloss>
<definition>
<form lang="en"><text>navigator (of a canoe)</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<trait name ="semantic-domain-ddp4" value="7.3.8 Transport"/>
<note type="anthropology">
<form lang="en"><text>There are a variety of hand signs used by the navigator to communicate with the operator (gall onyang). These include changing the way you're facing to mean "veer right or left", to point left, right, or straight to indicate a turn or the lack of one and to speed up. A large wave of the hand indicates a big turn or a series of turns. A raised closed hand indicates to slow down or to stop.</text></form>
</note>
<reversal type="en"><form lang="en"><text>navigator</text></form>
</reversal>
<illustration href="">
</illustration><relation type="Synonyms" ref="58c4d03e-8c8d-4e98-bc51-b8f112e599a1"/>
</sense>
</entry>
