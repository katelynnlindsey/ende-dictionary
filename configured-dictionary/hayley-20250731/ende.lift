<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>ignorance</text></gloss>
<definition>
<form lang="en"><text>ignorance, non-knowing; incomprehension, non-understanding</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example>
<form lang="kit"><text>Ende eka kame lla</text></form>
<translation type="Free translation">
<form lang="en"><text>person who doesn't speak Ende</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Obo kame dan amom bällädän.</text></form>
<translation type="Free translation">
<form lang="en"><text>She doesn't know (lit. her ignorance is) whom she will marry.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Ngäma kame da ada käza da daden walle ik mi.</text></form>
<translation type="Free translation">
<form lang="en"><text>We (excl.) don't realize (lit. it's our ignorance) that there's a crocodile in the water.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Ngämo kame dan ematta bongo mikutt alle.</text></form>
<translation type="Free translation">
<form lang="en"><text>I don't see (lit. my incomprehension is) why you're mad.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
