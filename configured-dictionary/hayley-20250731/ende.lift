<grammatical-info value="Transitive verb">
<trait name="Verb-infl-class" value="I"/></grammatical-info>
<gloss lang="en"><text>grab</text></gloss>
<definition>
<form lang="en"><text>to grab, get, catch</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example source="WE-ST018 2.4">
<form lang="kit"><text>Ngäna walle we gäbän allan ddia llädäd e.</text></form>
<translation type="Free translation">
<form lang="en"><text>I am jumping in the water to grab the deer.</text></form>
</translation>
<note type="reference">
<form lang="kit"><text><span href="silfw://localhost/link?tool%3dinterlinearEdit%26guid%3d82fb84c7-85ec-4ae6-9b44-7d0d0317230e%26tag%3d" class="Hyperlink">WE-ST018 2.4</span></text></form>
</note>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Ubi guspullän, be ubi obaoba gollädnegän.</text></form>
<translation type="Free translation">
<form lang="en"><text>They fell, but they caught themselves.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Iba pätt a ttongdae dan, ako kame ddone bällädeya.</text></form>
<translation type="Free translation">
<form lang="en"><text>We (incl.) only have one body; we don't get another.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<trait name ="semantic-domain-ddp4" value="7.3.3.1 Take something from somewhere"/>
<trait name ="semantic-domain-ddp4" value="7.2.6.1 Catch, capture"/>
<trait name ="semantic-domain-ddp4" value="7.4.3 Get"/>
<trait name ="semantic-domain-ddp4" value="6.8.9.4 Take by force"/>
<trait name ="semantic-domain-ddp4" value="7.3.1.2 Catch"/>
<reversal type="en"><form lang="en"><text>grab</text></form>
</reversal>
<illustration href="">
</illustration><relation type="Synonyms" ref="43665917-5227-4aee-9d58-b445de128a58"/>
