<trait  name="morph-type" value="stem"/>
<pronunciation>
<form lang="kit-fonipa"><text>ɖ͡ʐol</text></form>
</pronunciation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<sense id="d679e21e-1293-487c-ab50-305b373a2b02">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>foam</text></gloss>
<definition>
<form lang="en"><text>foam, bubbles, gas</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example>
<form lang="kit"><text>Ttongo lla da ddone mullae dan sisor gärep kae ine de gudne nyäng e banzämaeyän, adawatta gärep kae ine da mɨnyi ddol bogon a nyäng de bungolltän.</text></form>
<translation type="Free translation">
<form lang="en"><text>A man cannot pour new wine into an old bag, because the wine will become gassy and it will make the bag explode.</text></form>
</translation>
