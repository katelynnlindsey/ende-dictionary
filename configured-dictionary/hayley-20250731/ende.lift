<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example source="SE-LE054 152.1">
<form lang="kit"><text>Ngatengate da biratt a ddobae moko dan.</text></form>
<translation type="Free translation">
<form lang="en"><text>Roasted possum is very tasty.</text></form>
</translation>
