<gloss lang="en"><text>leaf_part</text></gloss>
<definition>
<form lang="en"><text>sheath, base, midrib (of a palm leaf)</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example source="Joshua Ben Danipa">
<form lang="kit"><text>Nge da ddagemeny dan, obo bugu daeben.</text></form>
<translation type="Free translation">
<form lang="en"><text>The coconut palm doesn't have branches, there are only its leaf sheaths.</text></form>
</translation>
<note type="reference">
<form lang="en"><text>Joshua Ben Danipa</text></form>
</note>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example source="Joshua Ben Danipa">
<form lang="kit"><text>Bugu dädär da aspunan.</text></form>
<translation type="Free translation">
<form lang="en"><text>Dry palm leaf sheaths fall.</text></form>
</translation>
<note type="reference">
<form lang="en"><text>Joshua Ben Danipa</text></form>
</note>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
