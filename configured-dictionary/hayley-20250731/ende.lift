<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example source="Joshua Ben Danipa">
<form lang="kit"><text>Witara da karama me däm ibeny ma ttängäm dan.</text></form>
<note type="reference">
<form lang="en"><text>Joshua Ben Danipa</text></form>
</note>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example source="SE-LE054 83.1">
<form lang="kit"><text>Witara me wayati da, pamker a, biye da wa mompel a däbem de ibeb erallo.</text></form>
<translation type="Free translation">
<form lang="en"><text>They are planting watermelon, pumpkin, taro, and aibika in the river garden.</text></form>
</translation>
<note type="reference">
<form lang="kit"><text><span href="silfw://localhost/link?tool%3dinterlinearEdit%26guid%3dba74042b-0062-4add-93e3-6797797d7164%26tag%3d" class="Hyperlink">SE-LE054 83.1</span></text></form>
</note>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example source="Joshua Ben Danipa">
<form lang="kit"><text>Lla da witara me mondre anggan.</text></form>
<note type="reference">
<form lang="en"><text>Joshua Ben Danipa</text></form>
</note>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<trait name ="semantic-domain-ddp4" value="6.2.9 Farmland"/>
<reversal type="en"><form lang="en"><text>plant term</text></form>
</reversal>
<illustration href="">
</illustration><relation type="Generic" ref="a539e401-595a-4057-95cf-b177025f7e67"/>
</sense>
</entry>
