<form lang="en"><text>On top he jumped like this into the water, down to the very bottom.</text></form>
</translation>
<note type="reference">
<form lang="kit"><text><span href="silfw://localhost/link?tool%3dinterlinearEdit%26guid%3d530da1eb-e55d-4b77-9f4d-eb3895ff4165%26tag%3d" class="Hyperlink">SE-TN016 46.1</span></text></form>
</note>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Igi me era däbe namllam.</text></form>
<translation type="Free translation">
<form lang="en"><text>[You] grab the one on the bottom.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<reversal type="en"><form lang="en"><text>bottom</text></form>
</reversal>
<illustration href="">
</illustration><relation type="Synonyms" ref="f5409d9e-3907-46ce-92cc-9d788d9a289e"/>
