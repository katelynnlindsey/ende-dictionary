<lexical-unit>
<form lang="kit"><text>däbe</text></form>
<form lang="kit-fonipa"><text>dəbe</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<pronunciation>
<form lang="kit-fonipa"><text>dəbe</text></form>
</pronunciation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<sense id="ab9b6c4b-5cb4-494a-919e-15a7c8768c08">
<grammatical-info value="Demonstrative">
</grammatical-info>
<gloss lang="en"><text>that</text></gloss>
<definition>
<form lang="en"><text>demonstrative, 'that,' could also translate as 'these' or 'those', depending on the context</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example source="SE-TN016 22.1">
<form lang="kit"><text>Bogo dindugän do kukiny mama de ikop dägagän dibaeya däbe ik e gotärakän do gotägolän.</text></form>
<translation type="Free translation">
<form lang="en"><text>He ran to a pile of tall grass that he saw, and went inside and hid there.</text></form>
