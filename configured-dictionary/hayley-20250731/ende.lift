<sense id="7fafdcbe-a10e-4a67-ba18-2136b169fc67">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>fish</text></gloss>
<definition>
<form lang="en"><text>fish</text></form>
<form lang="kit"><text>Walle ik me giddollnenang ddäddäg dag. (They are animals that live in the water.)</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example>
<form lang="kit"><text>Bäne kollba mu da auli dan?</text></form>
<translation type="Free translation">
<form lang="en"><text>How much for the fish?</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Ngämo kollba mu da ttongo ttang lläpät dan.</text></form>
<translation type="Free translation">
<form lang="en"><text>My fish is five kina.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example source="WE-ST031 2.7">
<form lang="kit"><text>Kollba da tämamae dadrowän a be kottllam aebe ttam dagirnän. </text></form>
<translation type="Free translation">
<form lang="en"><text>The fish all died but the turtle lived on.</text></form>
</translation>
<note type="reference">
<form lang="kit"><text><span href="silfw://localhost/link?tool%3dinterlinearEdit%26guid%3ddcba072f-7f7e-4330-b043-0f589b7999de%26tag%3d" class="Hyperlink">WE-ST031 2.7</span></text></form>
</note>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Bogo komlla kollba ulle de deyaittän.</text></form>
<translation type="Free translation">
<form lang="en"><text>He caught two big fish.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<trait name ="semantic-domain-ddp4" value="1.6.1.5 Fish"/>
<note type="source">
<form lang="en"><text>166:7</text></form>
</note>
<reversal type="en"><form lang="en"><text>fish</text></form>
</reversal>
