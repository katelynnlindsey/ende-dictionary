<entry dateCreated="2015-10-28T04:57:52Z" dateModified="2025-05-18T01:50:31Z" id="da1_499521ae-4dfc-44e1-a677-eb7841b1737f" guid="499521ae-4dfc-44e1-a677-eb7841b1737f" order="1">
<lexical-unit>
<form lang="kit"><text>da</text></form>
<form lang="kit-fonipa"><text>da</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<pronunciation>
<form lang="kit-fonipa"><text>da</text></form>
</pronunciation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<sense id="715c6e60-12ba-4f93-adf2-157a9c9f28e8" order="0">
<grammatical-info value="Subordinating connective">
</grammatical-info>
<gloss lang="en"><text>if</text></gloss>
<definition>
<form lang="en"><text>if, when (introduces a condition)</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example>
<form lang="kit"><text>Bongo ai dan da däbe melem de nanges, sisri nanges.</text></form>
<translation type="Free translation">
<form lang="en"><text>If you can do that job, do it today.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Da Joshua sɨmell de bäbäddän, ibi mɨnyi toto duwem e bäddägeya.</text></form>
<translation type="Free translation">
<form lang="en"><text>If Joshua shoots a pig, we will eat it for dinner.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Da Llimoll me lla da kuddäll bogon, komlla o kumuddäga lla da mɨnyi utt alle eka de bängaeyo.</text></form>
<translation type="Free translation">
<form lang="en"><text>When a person dies in Limol, two or three people will deliver the news with a conch shell.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<reversal type="en"><form lang="en"><text>if</text></form>
</reversal>
<illustration href="">
</illustration></sense>
<sense id="4312fbf4-ee66-4cb6-b5c2-1d6c64b6bf89" order="1">
<grammatical-info value="TAM particle">
</grammatical-info>
<gloss lang="en"><text>POT</text></gloss>
<definition>
<form lang="en"><text>might, may, could (marks potential mood)</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example>
<form lang="kit"><text>Kollokolloe eka panynen a mudan. Da iba eka de bawengameya.</text></form>
<translation type="Free translation">
<form lang="en"><text>Speaking a mixed language (i.e. code-switching) is no good. We might forget our (incl.) language.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<reversal type="en"><form lang="en"><text>POT</text></form>
</reversal>
<illustration href="">
</illustration><relation type="Synonyms" ref="d6e7fba1-366f-4e9b-8a5b-973e9210f6c7"/>
</sense>
</entry>
