<entry dateCreated="2017-11-08T05:00:48Z" dateModified="2025-05-18T01:50:31Z" id="ddol_4a8eb7c3-c378-47c8-b472-d6a035d532b8" guid="4a8eb7c3-c378-47c8-b472-d6a035d532b8">
<lexical-unit>
<form lang="kit"><text>ddol</text></form>
<form lang="kit-fonipa"><text>ɖ͡ʐol</text></form>
