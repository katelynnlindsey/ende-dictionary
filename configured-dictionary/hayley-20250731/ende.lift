<grammatical-info value="Transitive verb">
<trait name="Verb-infl-class" value="IV"/></grammatical-info>
<gloss lang="en"><text>lead</text></gloss>
<definition>
<form lang="en"><text>to lead, take, carry, collect</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example source="WE-ST010 2.1">
<form lang="kit"><text>Kwakmae obom dätramän walle we.</text></form>
<translation type="Free translation">
<form lang="en"><text>Kwakmae led him to the water.</text></form>
</translation>
<note type="reference">
<form lang="kit"><text><span href="silfw://localhost/link?tool%3dinterlinearEdit%26guid%3d265660f7-6638-4799-84b7-9c6617830d13%26tag%3d" class="Hyperlink">WE-ST010 2.1</span></text></form>
