<form lang="kit"><text>Nge pätt a tupi dan.</text></form>
<translation type="Free translation">
<form lang="en"><text>The coconut palm trunk is long.</text></form>
</translation>
<note type="reference">
<form lang="en"><text>Kauga Dobola</text></form>
</note>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Ubi up wo pätt dowae e gogeyo.</text></form>
<translation type="Free translation">
<form lang="en"><text>The two of them got close to the ripe banana tree.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Käp ku da wit pätt atta teti gongesnegän, ddob wit pätt atta siksti.</text></form>
<translation type="Free translation">
