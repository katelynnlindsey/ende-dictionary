<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example source="SE-TN019 15.1">
<form lang="kit"><text>Tutu we dirngäneyo a ubi dägabllabän.</text></form>
<translation type="Free translation">
<form lang="en"><text>She pulled her to land, and they stood.</text></form>
</translation>
<note type="reference">
<form lang="kit"><text><span href="silfw://localhost/link?tool%3dinterlinearEdit%26guid%3d07613564-d37a-427c-86e8-960268c544a5%26tag%3d" class="Hyperlink">SE-TN019 15.1</span></text></form>
