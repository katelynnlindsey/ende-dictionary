<relation type="Antonym" ref="2a81215e-3a60-4f21-965e-c45820005a08"/>
</sense>
<sense id="3cd7f633-83bf-42fb-add7-a307dc4d3e13" order="1">
<grammatical-info value="Locational">
</grammatical-info>
<gloss lang="en"><text>underneath</text></gloss>
<definition>
<form lang="en"><text>underneath</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example>
<form lang="kit"><text>Ge dädär de igi me era ekaklle da dakonenegän.</text></form>
