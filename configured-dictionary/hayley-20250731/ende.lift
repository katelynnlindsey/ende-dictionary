<example source="WE-ST010 3.2">
<form lang="kit"><text>Kauga angde Matthew bom ikop dägagän ddänddäm me, bogo mängalae gogbänän walle we, Matthew bom dirängänän. </text></form>
<translation type="Free translation">
<form lang="en"><text>When Kauga saw Matthew drowning, he quickly jumped into the water and lifted Matthew out.</text></form>
</translation>
<note type="reference">
<form lang="kit"><text><span href="silfw://localhost/link?tool%3dinterlinearEdit%26guid%3d265660f7-6638-4799-84b7-9c6617830d13%26tag%3d" class="Hyperlink">WE-ST010 3.2</span></text></form>
</note>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
