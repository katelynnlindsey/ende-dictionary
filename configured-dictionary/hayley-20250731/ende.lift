<sense id="c4a547fa-1a3b-445c-a10e-84baa6bb8432" order="0">
<grammatical-info value="Nominal enclitic">
</grammatical-info>
<gloss lang="en"><text>ALL</text></gloss>
<definition>
<form lang="en"><text>allative case clitic; to, into, towards</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example>
<form lang="kit"><text>Mälla da maket e nallan.</text></form>
<translation type="Free translation">
<form lang="en"><text>The woman goes to the market.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Ngämo näkäp e gongttagän ada ngaska zime iddob amänong agan.</text></form>
<translation type="Free translation">
<form lang="en"><text>It came to my mind that maybe it was already midnight.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Ngäna mɨnyi bäne eka de bäpänaeneg Ingglis e.</text></form>
<translation type="Free translation">
<form lang="en"><text>I'm going to translate your words into English.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<reversal type="en"><form lang="en"><text>to</text></form>
</reversal>
<reversal type="en"><form lang="en"><text>towards</text></form>
</reversal>
<illustration href="">
</illustration><relation type="Synonyms" ref="6f95956d-bfc4-4df2-90b4-e02e76b2cf21"/>
<relation type="Synonyms" ref="fcc85214-df72-4f7b-97ed-3e01eb1262d1"/>
</sense>
<sense id="4f6b5613-d41d-4a97-8c4e-b05025c3c634" order="1">
<grammatical-info value="Nominal enclitic">
</grammatical-info>
<gloss lang="en"><text>PURP</text></gloss>
<definition>
<form lang="en"><text>for, to (purposive use of the allative case; also follows nonfinite verbs to express desire, intention, or the start of an action)</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example>
<form lang="kit"><text>Ge mätta da känaebag e dan.</text></form>
<translation type="Free translation">
<form lang="en"><text>This yam is for tomorrow.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Obo moko da gäbän e dan.</text></form>
<translation type="Free translation">
<form lang="en"><text>He wants to jump (lit. his desire is to jump).</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Alla täräp me ibi ge nge de ibeny e dan?</text></form>
<translation type="Free translation">
<form lang="en"><text>At what time are we going to plant this coconut?</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<example>
<form lang="kit"><text>Gäddgädd e nängkaman.</text></form>
<translation type="Free translation">
<form lang="en"><text>He started to fight.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<reversal type="en"><form lang="en"><text>for</text></form>
</reversal>
<illustration href="">
</illustration></sense>
</entry>
