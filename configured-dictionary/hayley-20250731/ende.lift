<entry dateCreated="2016-07-31T23:40:28Z" dateModified="2025-05-18T01:50:31Z" id="tab_eff58689-1b7b-424b-91e6-43993f9a64aa" guid="eff58689-1b7b-424b-91e6-43993f9a64aa">
<lexical-unit>
<form lang="kit"><text>tab</text></form>
<form lang="kit-fonipa"><text>tab</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<pronunciation>
<form lang="kit-fonipa"><text>tab</text></form>
</pronunciation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<sense id="08181a0d-22ec-4fe6-890c-8622b899b35b" order="0">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>promise</text></gloss>
<definition>
<form lang="en"><text>promise, oath; engagement</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example>
<form lang="kit"><text>Tab de obo pate dangesän.</text></form>
<translation type="Free translation">
<form lang="en"><text>She made him a promise.</text></form>
</translation>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
</example>
<trait name ="semantic-domain-ddp4" value="3.5.1.9 Promise"/>
<note>
<form lang="en"><text>also means a mark: a piece of grass or mark on an object that shows that it is owned by someone, or shows that you have gone down a certain path. If you come to a junction, and you want to tell people behind which way you went, you put one leafy branch across the path which you are not taking, and put leafy branches going down the path that you are taking, with the bushy leaf parts behind and the stick points pointing forward.</text></form>
</note>
<reversal type="en"><form lang="en"><text>engagement</text></form>
</reversal>
<reversal type="en"><form lang="en"><text>oath</text></form>
</reversal>
<reversal type="en"><form lang="en"><text>promise</text></form>
</reversal>
<illustration href="">
</illustration></sense>
<sense id="7edefcff-0b20-42c3-b15c-e4bc79bee83e" order="1">
<grammatical-info value="Transitive coverb">
</grammatical-info>
<gloss lang="en"><text>promise</text></gloss>
<definition>
<form lang="en"><text>to promise</text></form>
</definition>
<trait name="do-not-publish-in" value="Verbal Dictionary"/>
<example>
<form lang="kit"><text>Ngäna bibim tab anggan.</text></form>
<translation type="Free translation">
<form lang="en"><text>I promise you all.</text></form>
</translation>
